# Ignore everything by default; the mod repos and the SDK clone are
# independent git repos and must not be embedded here, and docs/ holds
# process artifacts (specs, plans) intentionally left untracked. Only the
# shared, machine-agnostic files are tracked.
.DS_Store
__pycache__
/*
!/.gitignore
!/.tool-versions
!/.envrc.example
!/CLAUDE.md
!/utils/
!/README.md
!/docs/
/docs/*
!/docs/macos-crossover-loader.md
!/docs/publishing.md
# Track ONLY .claude/skills (shared agent skills). The parent dir must be
# un-ignored so git descends into it, then everything inside is re-ignored,
# then skills alone is re-allowed — so settings.json etc. stay local. Same
# three-line idiom as docs/ above.
!/.claude/
/.claude/*
!/.claude/skills