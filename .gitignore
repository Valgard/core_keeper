# Ignore everything by default; the mod repos and the SDK clone are
# independent git repos and must not be embedded here, and docs/ holds
# process artifacts (specs, plans) intentionally left untracked. Only the
# shared, machine-agnostic files are tracked.
.DS_Store
__pycache__
/*
!/.gitignore
!/.tool-versions
!/.envrc.example
!/.csharpierrc
!/.csharpierignore
!/.pre-commit-config.yaml
!/CLAUDE.md
!/utils/
!/README.md
# The uv project that pins what utils/ imports (Pillow exactly, since the font
# artifacts are checked by byte-identity). .venv stays ignored by the /* rule.
!/pyproject.toml
!/uv.lock
!/docs/
/docs/*
!/docs/dedicated-server.md
!/docs/macos-crossover-loader.md
!/docs/publishing.md
!/docs/pixaki-format.md
# The Core Keeper modding handbook — game/SDK reference, tracked as a whole
# directory rather than file by file, so new chapters need no gitignore edit.
!/docs/ck/
# Spec and ADR artefacts, per the project workflow: a design spec is committed
# before implementation, and later replaced by a distilled ADR. Whole
# directories for the same reason as docs/ck/ above — otherwise every new spec
# needs a gitignore edit, and the ones that do not get it stay invisible to git.
!/docs/specs/
!/docs/adrs/
# Track ONLY .claude/skills (shared agent skills). The parent dir must be
# un-ignored so git descends into it, then everything inside is re-ignored,
# then skills alone is re-allowed — so settings.json etc. stay local. Same
# three-line idiom as docs/ above.
!/.claude/
/.claude/*
!/.claude/skills
# Track ONLY the dotnet tool manifest inside .config/ (CSharpier version pin)
# — same three-line idiom as docs/ and .claude/ above.
!/.config/
/.config/*
!/.config/dotnet-tools.json