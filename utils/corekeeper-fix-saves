#!/usr/bin/env bash
# Core Keeper Save-Bootstrap unter CrossOver
#
# Behebt den Wine-Race-Bug bei Pugs Atomic-Rename: Pug schreibt .pugtmp,
# der finale rename auf den Original-Namen scheitert unter Wine. Dieses
# Skript fuehrt den Rename manuell aus und legt .pugbackup-Twins an.
#
# Drei Save-Kategorien:
#   - Welten     (worlds/, worldinfos/, worldgenparams/)  -> -s / --save <ID>
#   - Charaktere (saves/<C>.json)                         -> -c / --char <ID>
#   - Maps       (maps/<C>/<M>.mapparts.gzip)             -> immer global
#
# Modi:
#   - Global Mode (keine -s/-c gegeben): ALLE .pugtmps in allen Kategorien
#     werden gerettet. Default fuer den normalen Workflow.
#   - Specific Mode (mit -s und/oder -c): nur die angegebenen Slots werden
#     gerettet (Maps trotzdem immer global, weil Map-ID nicht ableitbar).

set -eo pipefail

BOTTLE_BASE="$HOME/Library/Application Support/CrossOver/Bottles/Core Keeper/drive_c/users/crossover/AppData/LocalLow/Pugstorm/Core Keeper/Steam"

usage() {
  cat <<EOF
Usage:
  $0 [OPTIONS] [STEAM_ID]

Options:
  -s, --save <WORLD_ID>    Gezielt nur diese Welt-ID retten
                           (worlds/<ID>.*, worldinfos/<ID>.*, worldgenparams/<ID>.*)
  -c, --char <CHAR_ID>     Gezielt nur diese Char-ID retten (saves/<ID>.json)
  -h, --help               Diese Hilfe

Positional:
  STEAM_ID                 Steam-User-ID (Verzeichnis unter Bottle/.../Steam/)
                           Fallback wenn nicht gegeben: \$COREKEEPER_STEAM_ID,
                           dann Auto-Detect (bei genau einer ID), dann Prompt.

Modi:
  Ohne -s/-c (Global Mode):
    Alle .pugtmps werden gerettet: alle Welten, alle Chars, alle Maps.
    Default fuer den normalen Workflow.

  Mit -s und/oder -c (Specific Mode):
    Nur die angegebenen Slots werden gerettet. Maps werden trotzdem alle
    gerettet (Map-ID != Welt-ID, nicht aus Slot ableitbar ohne JSON-Parser).

Beispiele:
  $0                          # Global: alles retten
  $0 -s 2                     # Nur Welt 2 (+ alle Maps)
  $0 -c 1                     # Nur Char 1 (+ alle Maps)
  $0 -s 2 -c 1                # Welt 2 + Char 1 (+ alle Maps)
  $0 -s 2 10510784            # Welt 2 in spezifischer Steam-ID
  COREKEEPER_STEAM_ID=10510784 $0 -s 2

ENV:
  COREKEEPER_STEAM_ID        Steam-User-ID (siehe oben)
EOF
}

WORLD_SLOT=""
CHAR_ID=""
STEAM_ID_FROM_POS=""
SPECIFIC_MODE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -s|--save)
      if [[ -z "${2:-}" ]]; then
        echo "Option $1 erwartet eine Welt-ID" >&2
        exit 1
      fi
      WORLD_SLOT="$2"
      SPECIFIC_MODE=1
      shift 2
      ;;
    -c|--char)
      if [[ -z "${2:-}" ]]; then
        echo "Option $1 erwartet eine Char-ID" >&2
        exit 1
      fi
      CHAR_ID="$2"
      SPECIFIC_MODE=1
      shift 2
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        if [[ -n "$STEAM_ID_FROM_POS" ]]; then
          echo "Zu viele positionale Argumente: $1" >&2
          exit 1
        fi
        STEAM_ID_FROM_POS="$1"
        shift
      done
      ;;
    -*)
      echo "Unbekannte Option: $1" >&2
      echo "Siehe $0 --help" >&2
      exit 1
      ;;
    *)
      if [[ -n "$STEAM_ID_FROM_POS" ]]; then
        echo "Zu viele positionale Argumente: $1" >&2
        exit 1
      fi
      STEAM_ID_FROM_POS="$1"
      shift
      ;;
  esac
done

STEAM_ID="${STEAM_ID_FROM_POS:-${COREKEEPER_STEAM_ID:-}}"

# Validate IDs
if [[ -n "$WORLD_SLOT" ]] && ! [[ "$WORLD_SLOT" =~ ^[0-9]+$ ]]; then
  echo "Welt-ID muss eine nicht-negative Ganzzahl sein: '$WORLD_SLOT'" >&2
  exit 1
fi
if [[ -n "$CHAR_ID" ]] && ! [[ "$CHAR_ID" =~ ^[0-9]+$ ]]; then
  echo "Char-ID muss eine nicht-negative Ganzzahl sein: '$CHAR_ID'" >&2
  exit 1
fi

# Steam-ID aufloesen
if [[ -z "$STEAM_ID" ]]; then
  if [[ ! -d "$BOTTLE_BASE" ]]; then
    echo "Bottle nicht gefunden: $BOTTLE_BASE" >&2
    exit 1
  fi
  available=()
  while IFS= read -r d; do
    [[ -n "$d" ]] && available+=("$d")
  done < <(ls "$BOTTLE_BASE" 2>/dev/null)

  if [[ ${#available[@]} -eq 0 ]]; then
    echo "Keine Steam-ID-Verzeichnisse in $BOTTLE_BASE gefunden." >&2
    exit 1
  elif [[ ${#available[@]} -eq 1 ]]; then
    STEAM_ID="${available[0]}"
    echo "Auto-detected Steam-ID: $STEAM_ID"
  else
    echo "Mehrere Steam-IDs gefunden:"
    for i in "${!available[@]}"; do
      echo "  [$i] ${available[$i]}"
    done
    read -rp "Steam-ID (Index oder direkt eingeben): " sel
    if [[ "$sel" =~ ^[0-9]+$ ]] && [[ "$sel" -lt "${#available[@]}" ]]; then
      STEAM_ID="${available[$sel]}"
    else
      STEAM_ID="$sel"
    fi
  fi
fi

SAVEDIR="$BOTTLE_BASE/$STEAM_ID"
if [[ ! -d "$SAVEDIR" ]]; then
  echo "Save-Verzeichnis nicht gefunden: $SAVEDIR" >&2
  exit 1
fi

# Pre-Flight: Spiel darf nicht laufen
if /usr/bin/pgrep -f "CoreKeeper\.exe" > /dev/null 2>&1; then
  echo "WARNUNG: Core Keeper laeuft noch. Bitte erst komplett beenden." >&2
  exit 2
fi

cd "$SAVEDIR"

# Globaler Pre-Check
if [[ -z "$(find . -name '*.pugtmp' -type f -print -quit 2>/dev/null)" ]]; then
  echo "Keine .pugtmp-Files in $SAVEDIR gefunden. Nichts zu retten."
  exit 0
fi

found=0

rescue_file() {
  local tmp="$1"
  local kind="${2:-file}"
  if [[ ! -f "$tmp" ]]; then
    echo "  [skip] $tmp (nicht da)"
    return 1
  fi
  local final="${tmp%.pugtmp}"
  local backup="${final}.pugbackup"
  mv "$tmp" "$final"
  cp "$final" "$backup"
  local size
  size=$(wc -c < "$final" | tr -d ' ')
  echo "  [OK]   $final ($size bytes, $kind)"
  found=1
  return 0
}

rescue_world_slot() {
  local slot="$1"
  echo
  echo "Rescue Welt-Slot $slot:"
  rescue_file "worlds/${slot}.world.gzip.pugtmp" "world" || true
  rescue_file "worldinfos/${slot}.worldinfo.pugtmp" "world" || true
  rescue_file "worldgenparams/${slot}.json.pugtmp" "world" || true
}

rescue_char_id() {
  local cid="$1"
  echo
  echo "Rescue Char-ID $cid:"
  rescue_file "saves/${cid}.json.pugtmp" "char" || true
}

echo "Modus: $([[ $SPECIFIC_MODE -eq 1 ]] && echo 'Specific' || echo 'Global') (Steam-ID $STEAM_ID)"

# (1) Welten
if [[ $SPECIFIC_MODE -eq 0 ]]; then
  # Global: alle Welt-pugtmps
  world_slots=()
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    base=$(basename "$f")
    slot="${base%.world.gzip.pugtmp}"
    [[ "$slot" != "$base" ]] && world_slots+=("$slot")
  done < <(find worlds -name "*.world.gzip.pugtmp" 2>/dev/null)

  if [[ ${#world_slots[@]} -gt 0 ]]; then
    for slot in "${world_slots[@]}"; do
      rescue_world_slot "$slot"
    done
  else
    echo
    echo "Welten: keine .pugtmps"
  fi
elif [[ -n "$WORLD_SLOT" ]]; then
  rescue_world_slot "$WORLD_SLOT"
fi

# (2) Charaktere
if [[ $SPECIFIC_MODE -eq 0 ]]; then
  echo
  echo "Rescue Charaktere (global):"
  char_count=0
  while IFS= read -r tmp; do
    [[ -z "$tmp" || ! -f "$tmp" ]] && continue
    rescue_file "$tmp" "char"
    char_count=$((char_count + 1))
  done < <(find saves -name "*.json.pugtmp" 2>/dev/null)
  [[ $char_count -eq 0 ]] && echo "  (keine Char-pugtmps)"
elif [[ -n "$CHAR_ID" ]]; then
  rescue_char_id "$CHAR_ID"
fi

# (3) Maps — IMMER global, weil Map-ID != Welt-ID
echo
echo "Rescue Maps (global):"
map_count=0
while IFS= read -r tmp; do
  [[ -z "$tmp" || ! -f "$tmp" ]] && continue
  rescue_file "$tmp" "map"
  map_count=$((map_count + 1))
done < <(find maps -name "*.mapparts.gzip.pugtmp" 2>/dev/null)
[[ $map_count -eq 0 ]] && echo "  (keine Map-pugtmps)"

# (4) Catch-all — alle uebrig gebliebenen .pugtmp irgendwo im SAVEDIR
# Faengt: Root-Level-Configs (Admins.json, PlayerBans.json, prefs.json,
# ServerConfig.json), cloudconflicts/* (Cloud-Sync-Backups), und alle
# zukuenftigen Save-Pfade die Pug eventuell einfuehrt.
# Spezifische Blocks (1-3) haben ihre Files schon umbenannt, hier kommt
# nur was uebrig ist.
echo
echo "Rescue Sonstiges (catch-all):"
other_count=0
while IFS= read -r tmp; do
  [[ -z "$tmp" || ! -f "$tmp" ]] && continue
  rescue_file "$tmp" "other"
  other_count=$((other_count + 1))
done < <(find . -name "*.pugtmp" -type f 2>/dev/null)
[[ $other_count -eq 0 ]] && echo "  (keine weiteren .pugtmps)"

if [[ $found -eq 0 ]]; then
  echo
  echo "Nichts gerettet."
  exit 0
fi

echo
echo "Done. Du kannst Core Keeper jetzt neu starten."
