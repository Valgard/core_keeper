}

// Patch-5-Fingerprint: Stock StandaloneFilesystem.Delete(string) ruft File.Move
// auf (Soft-Delete via Rename auf .pugbackup). Der Hard-Delete-Rewrite entfernt
// File.Move vollständig. Abwesenheit von File.Move ist der zuverlässige Marker —
// File.Delete/File.Exists kommen auch im Stock-Body vor und taugen nicht.
static bool HasHardDeleteFingerprint(MethodDefinition del)
{
    foreach (var insn in del.Body.Instructions)
    {
        if ((insn.OpCode == OpCodes.Call || insn.OpCode == OpCodes.Callvirt)
            && insn.Operand is MethodReference mr
            && mr.DeclaringType.FullName == "System.IO.File"
            && mr.Name == "Move")
        {
