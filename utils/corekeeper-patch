// ============================================================================
// Spielverzeichnis -> Managed-Verzeichnis
// ============================================================================
// Unity legt die Managed-Assemblies unter "<Spiel>/<Produktname>_Data/Managed"
// ab. Der Produktname unterscheidet sich zwischen den Builds — Client
// "CoreKeeper_Data", Dedicated Server "CoreKeeperServer_Data" — deshalb wird
// der Ordner per *_Data-Glob gesucht statt fest benannt. Ein bereits tiefer
// zeigender Pfad (das *_Data- oder das Managed-Verzeichnis selbst) wird
// ebenfalls akzeptiert, damit der Aufruf nicht an einer Ebene scheitert.
static string ResolveManagedDir(string gamePath)
{
    if (!Directory.Exists(gamePath))
    {
        return null;
    }

    if (Path.GetFileName(gamePath).Equals("Managed", StringComparison.OrdinalIgnoreCase))
    {
        return gamePath;
    }

    string direct = Path.Combine(gamePath, "Managed");
    if (Directory.Exists(direct))
    {
        return direct;
    }

    foreach (string dataDir in Directory.GetDirectories(gamePath, "*_Data").OrderBy(d => d))
    {
        string managed = Path.Combine(dataDir, "Managed");
        if (Directory.Exists(managed))
        {
            return managed;
        }
    }

    return null;
}

// ============================================================================
// PugMod.Loader.dll — Patch 1 (Directory.Delete) + Patch 2 (InvariantCulture)
// ============================================================================
static int ProcessLoaderDll(string dllPath, bool apply)
{
    Console.WriteLine();
    Console.WriteLine("DLL: " + dllPath);
    Console.WriteLine();

    if (!File.Exists(dllPath))
    {
        Console.Error.WriteLine("FEHLER: DLL nicht gefunden.");
        return 1;
    }

    // Resolver muss das Managed/-Dir kennen, sonst scheitert module.Write() für
    // DLLs mit Cross-Assembly-Type-Refs (Pug.Other -> Pug.Base etc.) während
    // der Metadata-Build-Phase.
    var resolver = new DefaultAssemblyResolver();
    resolver.AddSearchDirectory(Path.GetDirectoryName(dllPath));

    using var module = ModuleDefinition.ReadModule(
        dllPath, new ReaderParameters
        {
            ReadWrite = apply,
            AssemblyResolver = resolver,
        });

    var type = module.GetType(LoaderTypeName);
    if (type == null)
    {
        Console.Error.WriteLine("FEHLER: Typ " + LoaderTypeName
            + " nicht gefunden — Spiel verändert? Kein Patch angewendet.");
        return 1;
    }

    bool anyChange = false;
    bool anyGameChanged = false;
    bool allWereUnpatched = true;  // wird false bei BEREITS GEPATCHT / SPIEL VERÄNDERT

    // === Patch 1: Directory.Delete(string,bool) -> pop pop =================
    // The single recursive directory delete in PugMod.Loader fails under Wine
    // and aborts the whole mod-load pass. Replacing the call with two pops
    // discards its two arguments, keeps the IL stack balanced, and does nothing
    // else.
    {
        var hits = new List<(MethodDefinition Method, Instruction Insn)>();
        foreach (var m in type.Methods)
        {
            if (!m.HasBody) continue;
            foreach (var insn in m.Body.Instructions)
            {
                if (insn.OpCode != OpCodes.Call && insn.OpCode != OpCodes.Callvirt)
                    continue;
                if (insn.Operand is MethodReference mr
                    && IsDirectoryDeleteStringBool(mr))
                    hits.Add((m, insn));
            }
        }

        if (hits.Count == 1)
        {
            var (method, deleteCall) = hits[0];
            if (apply)
            {
                var il = method.Body.GetILProcessor();
                deleteCall.OpCode = OpCodes.Pop;
                deleteCall.Operand = null;
                il.InsertAfter(deleteCall, Instruction.Create(OpCodes.Pop));
                anyChange = true;
                Report(1, "Directory.Delete -> pop pop",
                    "NICHT GEPATCHT -> GEPATCHT [OK]  (" + method.Name + ")");
            }
            else
            {
                Report(1, "Directory.Delete -> pop pop",
                    "NICHT GEPATCHT  (" + method.Name + ", IL 0x"
                    + deleteCall.Offset.ToString("X4") + ")");
            }
        }
        else if (hits.Count == 0 && HasPopPopFingerprint(type))
        {
            allWereUnpatched = false;
            Report(1, "Directory.Delete -> pop pop", "BEREITS GEPATCHT");
        }
        else
        {
            anyGameChanged = true;
            allWereUnpatched = false;
            string why = hits.Count > 1
                ? hits.Count + " Directory.Delete(string,bool)-Aufrufe gefunden"
                : "kein Directory.Delete(string,bool) und kein pop-pop-Muster";
            Report(1, "Directory.Delete -> pop pop",
                "SPIEL VERÄNDERT — übersprungen (" + why + ")");
        }
    }

    // === Patch 2: force InvariantCulture so Roslyn skips the satellite lookup
    // Under the German Wine locale, Roslyn fetches a localized diagnostic
    // string from a de-DE satellite assembly that the game does not ship -> the
    // FileNotFoundException aborts the mod-load pass. Setting the process-wide
    // default UI culture to Invariant in Loader.Init (before any compilation,
    // so Roslyn's later worker threads inherit it) makes Roslyn fall back to
    // the embedded English resources and never look up a satellite at all.
    {
        var initMethods = type.Methods
            .Where(m => m.Name == "Init" && m.HasBody).ToList();

        if (initMethods.Count != 1)
        {
            anyGameChanged = true;
            allWereUnpatched = false;
            Report(2, "Roslyn-Locale (InvariantCulture)",
                "SPIEL VERÄNDERT — übersprungen (" + initMethods.Count
                + " Methoden 'Init' mit Body, erwartet 1)");
        }
        else
        {
            var init = initMethods[0];
            bool already = init.Body.Instructions.Any(insn =>
                (insn.OpCode == OpCodes.Call || insn.OpCode == OpCodes.Callvirt)
                && insn.Operand is MethodReference mr
                && IsSetDefaultThreadCurrentUICulture(mr));

            if (already)
            {
                allWereUnpatched = false;
                Report(2, "Roslyn-Locale (InvariantCulture)", "BEREITS GEPATCHT");
            }
            else if (apply)
            {
                // Build the references manually against the MODULE's own corlib.
                // Importing from the tool's .NET 10 typeof(CultureInfo) would
                // point at System.Private.CoreLib (a .NET 10 identity) which the
                // game's Mono runtime does not have -> runtime TypeLoadException.
                var corlib = module.TypeSystem.CoreLibrary;
                var cultureInfo = new TypeReference(
                    "System.Globalization", "CultureInfo", module, corlib);

                var getInvariant = new MethodReference(
                    "get_InvariantCulture", cultureInfo, cultureInfo)
                    { HasThis = false };

                var setDefaultUiCulture = new MethodReference(
                    "set_DefaultThreadCurrentUICulture",
                    module.TypeSystem.Void, cultureInfo) { HasThis = false };
                setDefaultUiCulture.Parameters.Add(
                    new ParameterDefinition(cultureInfo));

                var il = init.Body.GetILProcessor();
                var first = init.Body.Instructions[0];
                il.InsertBefore(first,
                    Instruction.Create(OpCodes.Call, getInvariant));
                il.InsertBefore(first,
                    Instruction.Create(OpCodes.Call, setDefaultUiCulture));
                anyChange = true;
                Report(2, "Roslyn-Locale (InvariantCulture)",
                    "NICHT GEPATCHT -> GEPATCHT [OK]  (Init)");
            }
            else
            {
                Report(2, "Roslyn-Locale (InvariantCulture)",
                    "NICHT GEPATCHT  (Init)");
            }
        }
    }

    if (apply && anyChange)
    {
        WriteDll(dllPath, module, allWereUnpatched);
    }

    return anyGameChanged ? 1 : 0;
}

// ============================================================================
// Pug.Other.dll — Patch 3 (Initial-Save direct-write fallback)
//               + Patch 4 (DeleteDirectory rewrite — Iter-and-Delete)
// ============================================================================
static int ProcessOtherDll(string dllPath, bool apply)
{
    Console.WriteLine();
    Console.WriteLine("DLL: " + dllPath);
    Console.WriteLine();

    if (!File.Exists(dllPath))
    {
        Console.Error.WriteLine("FEHLER: DLL nicht gefunden.");
        return 1;
    }

    // Resolver muss das Managed/-Dir kennen, sonst scheitert module.Write() für
    // DLLs mit Cross-Assembly-Type-Refs (Pug.Other -> Pug.Base etc.) während
    // der Metadata-Build-Phase.
    var resolver = new DefaultAssemblyResolver();
    resolver.AddSearchDirectory(Path.GetDirectoryName(dllPath));

    using var module = ModuleDefinition.ReadModule(
        dllPath, new ReaderParameters
        {
            ReadWrite = apply,
            AssemblyResolver = resolver,
        });

    var fsType = module.GetType(FsTypeName);
    if (fsType == null)
    {
        Console.Error.WriteLine("FEHLER: Typ " + FsTypeName
            + " nicht gefunden — Spiel verändert? Kein Patch angewendet.");
        return 1;
    }

    bool anyChange = false;
    bool anyGameChanged = false;
    bool allWereUnpatched = true;  // siehe Kommentar in ProcessLoaderDll

    // === Patch 3: Initial-Save direct-write fallback ========================
    // In CK 1.2.1.3 schreibt Pugs atomic-rename Save-Pfad (temp .pugtmp ->
    // File.Move/File.Replace -> Original) unter Wine bei Initial-Save (Original
    // existiert noch nicht) gar nichts auf Disk. Die Welt/der Char verschwindet
    // beim CK-Neustart komplett aus dem UI. Stack-Trace immer
    // Pug.Platform.StandaloneFilesystem:Write -> FilesystemManager:WriteHandler;
    // Error-Code -2147024896 = 0x80070000 = HRESULT_FROM_WIN32(ERROR_SUCCESS)
    // (Wine-Quirk: File-API returnt FALSE ohne SetLastError).
    //
    // Patch injiziert am Anfang von Write(string,string,byte[]) einen
    // **unconditional** Direct-Write-Versuch via File.WriteAllBytes. Frühere
    // Variante hatte ein File.Exists-Guard, der unter Wine offenbar fälschlich
    // 'true' für nicht-existente Slot-N-Files zurückgab und den Direct-Write
    // damit übersprungen hat (siehe Test-Lauf 23. Mai: 13 Failures pre vs
    // 12-13 post, alle auf .pugbackup-Pfaden, Patch v1 war faktisch ein
    // No-Op). v2 verzichtet auf File.Exists und versucht den Direct-Write
    // **immer**. Auf Erfolg: return. Auf IOException: Catch swallows, Fall-
    // Through in die bestehende Atomic-Rename-Logik. Trade-off: Update-Saves
    // verlieren Atomic-Rename-Safety (kein .pugbackup mehr für überschriebene
    // Original-Files) — akzeptiert für die Hypothesen-Verifikation.
    {
        var writeMethods = fsType.Methods.Where(m =>
            m.Name == "Write" && m.HasBody
            && m.Parameters.Count == 3
            && m.Parameters[0].ParameterType.FullName == "System.String"
            && m.Parameters[1].ParameterType.FullName == "System.String"
            && m.Parameters[2].ParameterType.FullName == "System.Byte[]"
        ).ToList();

        if (writeMethods.Count != 1)
        {
            anyGameChanged = true;
            allWereUnpatched = false;
            Report(3, "Save direct-write fallback",
                "SPIEL VERÄNDERT — übersprungen (" + writeMethods.Count
                + " Write(string,string,byte[]) gefunden, erwartet 1)");
        }
        else
        {
            var write = writeMethods[0];
            bool already = HasDirectWriteFingerprint(write);

            if (already)
            {
                allWereUnpatched = false;
                Report(3, "Save direct-write fallback", "BEREITS GEPATCHT");
            }
            else if (apply)
            {
                ApplyDirectWriteFallback(write, module);
                anyChange = true;
                Report(3, "Save direct-write fallback",
                    "NICHT GEPATCHT -> GEPATCHT [OK]  (" + write.Name + ")");
            }
            else
            {
                Report(3, "Save direct-write fallback",
                    "NICHT GEPATCHT  (" + write.Name + ", IL 0x"
                    + write.Body.Instructions[0].Offset.ToString("X4") + ")");
            }
        }
    }

    // === Patch 4: DeleteDirectory rewrite (Iter-and-Delete) =================
    // CK 1.2.1.4 ruft FilesystemManager.Backup() → BackupFolder() → mehrere
    // DeleteDirectory- und CopyDirectory-Calls auf, die alle über
    // StandaloneFilesystem.DeleteDirectory bzw. -.CopyDirectory laufen.
    //
    // StandaloneFilesystem.DeleteDirectory(path) ruft im Stock-Body nur
    // Directory.Delete(Rel2Abs(path), true) auf. Unter Unity-Mono in Wine ist
    // genau dieser recursive-true-Pfad broken (mscorlib's
    // PathInternal.EnsureExtendedPrefix stellt \\?\ aggressiv voran,
    // FindFirstFileExW-basiertes RemoveDirectoryRecursive wirft IOException).
    // Empirisch verifiziert (csc-compiled Wine-Test 2026-05-27):
    //  - File.Delete(single file)           : OK
    //  - Directory.Delete(empty, false)     : OK
    //  - Directory.EnumerateFiles/GetFiles  : OK
    //  - Directory.GetDirectories           : OK
    //  - Iter-and-Delete (this Patch's Alg) : OK auf CK-mirror Pfaden
    // Single-File-/Single-Dir-APIs nutzen unter Wine andere Code-Pfade als
    // RemoveDirectoryRecursive und sind nicht broken.
    //
    // Body-Rewrite ersetzt den ganzen Method-Körper durch:
    //     string abs = Rel2Abs(path);
    //     try {
    //         foreach file in GetFiles(abs, "*", AllDirectories): File.Delete(file)
    //         dirs = GetDirectories(abs, "*", AllDirectories)
    //         Bubble-sort dirs descending by string-length (deepest first)
    //         foreach dir in dirs: Directory.Delete(dir, false)
    //         Directory.Delete(abs, false)
    //     } catch { swallow }
    //
    // Effekt: Alle DeleteDirectory-Caller (BackupFolder × 2, UI-Welt-Löschen,
    // Mod-Cleanup, etc.) nutzen den Wine-kompatiblen Code-Pfad. Backups werden
    // tatsächlich rotiert, kein no-op-Verzicht.
    {
        // fsType (StandaloneFilesystem) ist schon oben für Patch 3 geladen.
        var deleteMethods = fsType.Methods.Where(m =>
            m.Name == "DeleteDirectory" && m.HasBody
            && m.Parameters.Count == 1
            && m.Parameters[0].ParameterType.FullName == "System.String"
        ).ToList();

        if (deleteMethods.Count != 1)
        {
            anyGameChanged = true;
            allWereUnpatched = false;
            Report(4, "DeleteDirectory rewrite",
                "SPIEL VERÄNDERT — übersprungen (" + deleteMethods.Count
                + " DeleteDirectory(string) gefunden, erwartet 1)");
        }
        else
        {
            var dd = deleteMethods[0];
            if (HasIterAndDeleteFingerprint(dd))
            {
                allWereUnpatched = false;
                Report(4, "DeleteDirectory rewrite", "BEREITS GEPATCHT");
            }
            else if (apply)
            {
                ApplyDeleteDirectoryRewrite(dd, module);
                anyChange = true;
                Report(4, "DeleteDirectory rewrite",
                    "NICHT GEPATCHT -> GEPATCHT [OK]  (DeleteDirectory body replaced)");
            }
            else
            {
                Report(4, "DeleteDirectory rewrite",
                    "NICHT GEPATCHT  (DeleteDirectory, Stock-Body "
                    + dd.Body.Instructions.Count + " Instructions)");
            }
        }
    }

    // === Patch 5: StandaloneFilesystem.Delete(string) rewrite ===============
    // UI-Welt-Löschen läuft NICHT über DeleteDirectory (Patch 4), sondern
    // datei-für-datei über StandaloneFilesystem.Delete(string):
    //   SaveSlotDeleteOption.DeleteSaveSlot -> SaveManager.RemoveWorld(id)
    //     -> filesystemManager.Delete(File) -> StandaloneFilesystem.Delete(string)
    //
    // Stock-Body ist ein SOFT-Delete (kein echtes Löschen):
    //     string src = Rel2Abs(path);
    //     string bak = Rel2Abs(path + ".pugbackup");
    //     if (File.Exists(bak)) File.Delete(bak);
    //     File.Move(src, bak);          // <-- bricht unter Wine: 0x80070000
    //
    // File.Move (+ das File.Exists-Quirk) ist exakt die Wine-Fehlerklasse, die
    // Patch 3 für Write behandelt — File.Move returnt FALSE ohne SetLastError,
    // der Move scheitert, das Original bleibt liegen → die Welt erscheint weiter
    // in der UI. Beweis im Player.log:
    //   Delete failed: Erfolg : '...3.world.gzip.pugbackup' (-2147024896)
    //     Pug.Platform.StandaloneFilesystem:Delete (string)
    //
    // Body-Rewrite ersetzt den Soft-Delete durch ein Wine-safes Hard-Delete:
    //     string abs = Rel2Abs(path);
    //     if (File.Exists(abs)) File.Delete(abs);
    //     string bak = Rel2Abs(path + ".pugbackup");
    //     if (File.Exists(bak)) File.Delete(bak);   // räumt .pugbackup-Orphan mit
    //     catch (Exception) { }
    // File.Delete(single file) ist laut Patch-4-Wine-Test verifiziert safe.
    // Trade-off: kein Soft-Delete-"Papierkorb" mehr (unter Wine ohnehin kaputt);
    // Nebeneffekt: beseitigt die .pugbackup-Orphans, die Pug beim UI-Delete
    // sonst liegen lässt.
    {
        var delMethods = fsType.Methods.Where(m =>
            m.Name == "Delete" && m.HasBody
            && m.Parameters.Count == 1
            && m.Parameters[0].ParameterType.FullName == "System.String"
        ).ToList();

        if (delMethods.Count != 1)
        {
            anyGameChanged = true;
            allWereUnpatched = false;
            Report(5, "Delete(string) hard-delete",
                "SPIEL VERÄNDERT — übersprungen (" + delMethods.Count
                + " Delete(string) gefunden, erwartet 1)");
        }
        else
        {
            var del = delMethods[0];
            if (HasHardDeleteFingerprint(del))
            {
                allWereUnpatched = false;
                Report(5, "Delete(string) hard-delete", "BEREITS GEPATCHT");
            }
            else if (apply)
            {
                ApplyDeleteRewrite(del, module);
                anyChange = true;
                Report(5, "Delete(string) hard-delete",
                    "NICHT GEPATCHT -> GEPATCHT [OK]  (Delete body replaced)");
            }
            else
            {
                Report(5, "Delete(string) hard-delete",
                    "NICHT GEPATCHT  (Delete, Stock-Body "
                    + del.Body.Instructions.Count + " Instructions)");
            }
        }
    }

    if (apply && anyChange)
    {
        WriteDll(dllPath, module, allWereUnpatched);
    }

    return anyGameChanged ? 1 : 0;
}

// ============================================================================
// IL-Injection für Patch 3 — In-Catch-Recovery (v3-Design)
//
// Konzeptuell:
//
//   public void Write(string name, string path, byte[] data)
//   {
//       try { ...bestehender 3-Schritt-Code... }
//       catch (IOException ex3)
//       {
//           Debug.LogError("Write failed: " + ex3.Message + " ...");  // bestehend
//
//           // INJECTED: nested try-catch für Recovery via direct-write
//           try { File.WriteAllBytes(Rel2Abs(path), data); }
//           catch { /* swallow, original failure schon geloggt */ }
//       }
//   }
//
// Vorteile gegenüber v2:
//   - Atomic-Rename-Safety für Updates BLEIBT — original-3-Schritt läuft
//     zuerst, recovery nur bei tatsächlichem Failure.
//   - Direct-write feuert nur bei broken Wine-Pfaden (Initial-Save), nicht
//     bei jedem Schreibvorgang.
//   - Catch-Type ist Exception (nicht IOException), damit auch Wine-spezifische
//     Non-IO-Exceptions geschluckt werden.
//
static void ApplyDirectWriteFallback(MethodDefinition write, ModuleDefinition module)
{
    var il = write.Body.GetILProcessor();

    // Bestehenden Outer-Catch finden (IOException-Handler mit kleinstem
    // TryStart.Offset = outermost; Cecil ordnet Handler inner-first,
    // FirstOrDefault gibt sonst den Phase-1-Inner-Catch zurück, der den
    // falschen Code-Pfad guarded).
    var outerCatch = write.Body.ExceptionHandlers
        .Where(h => h.HandlerType == ExceptionHandlerType.Catch
            && h.CatchType?.FullName == "System.IO.IOException")
        .OrderBy(h => h.TryStart.Offset)
        .FirstOrDefault();
    if (outerCatch == null)
        throw new Exception("Kein IOException-Catch-Handler in Write gefunden — Spiel verändert?");

    // Letztes Instruction im Handler ist HandlerEnd.Previous. Sollte ein leave sein.
    var existingLeave = outerCatch.HandlerEnd.Previous;
    if (existingLeave.OpCode != OpCodes.Leave && existingLeave.OpCode != OpCodes.Leave_S)
        throw new Exception("Erwartetes 'leave' am Catch-Handler-Ende, gefunden: " + existingLeave.OpCode);

    // Refs aufbauen
    var rel2Abs = write.DeclaringType.Methods.Single(m =>
        m.Name == "Rel2Abs"
        && m.Parameters.Count == 1
        && m.Parameters[0].ParameterType.FullName == "System.String");

    var corlib = module.TypeSystem.CoreLibrary;
    var fileType = new TypeReference("System.IO", "File",   module, corlib);
    var exType   = new TypeReference("System",    "Exception", module, corlib);

    var writeAllBytesRef = new MethodReference(
        "WriteAllBytes", module.TypeSystem.Void, fileType) { HasThis = false };
    writeAllBytesRef.Parameters.Add(new ParameterDefinition(module.TypeSystem.String));
    writeAllBytesRef.Parameters.Add(
        new ParameterDefinition(new ArrayType(module.TypeSystem.Byte)));

    // Instruktionen für nested try-catch:
    //   try {
    //     ldarg.0; ldarg.2; call Rel2Abs; ldarg.3; call WriteAllBytes
    //     leave.s existingLeave
    //   }
    //   catch (Exception) {
    //     pop
    //     leave.s existingLeave
    //   }
    var iLoadThis    = Instruction.Create(OpCodes.Ldarg_0);
    var iLoadPath    = Instruction.Create(OpCodes.Ldarg_2);
    var iCallRel2Abs = Instruction.Create(OpCodes.Call, rel2Abs);
    var iLoadData    = Instruction.Create(OpCodes.Ldarg_3);
    var iCallWriteAll = Instruction.Create(OpCodes.Call, writeAllBytesRef);
    var iTryLeave    = Instruction.Create(OpCodes.Leave, existingLeave);
    var iCatchPop    = Instruction.Create(OpCodes.Pop);
    var iCatchLeave  = Instruction.Create(OpCodes.Leave, existingLeave);

    Instruction[] toInsert = new[]
    {
        iLoadThis, iLoadPath, iCallRel2Abs, iLoadData, iCallWriteAll,
        iTryLeave,
        iCatchPop, iCatchLeave,
    };
    foreach (var insn in toInsert) il.InsertBefore(existingLeave, insn);

    // Nested Exception-Handler — komplett innerhalb des bestehenden Outer-Catch.
    // CIL-Verifier-konform: nested handler region ⊆ outer handler region.
    write.Body.ExceptionHandlers.Add(new ExceptionHandler(ExceptionHandlerType.Catch)
    {
        TryStart     = iLoadThis,
        TryEnd       = iCatchPop,
        HandlerStart = iCatchPop,
        HandlerEnd   = existingLeave,
        CatchType    = module.ImportReference(exType)
    });
}

