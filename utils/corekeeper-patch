// Patch-4-Fingerprint: nach Body-Replacement ruft DeleteDirectory u.a.
// Directory.GetFiles oder File.Delete auf — beides ist im Stock-Body nicht
// vorhanden (Stock ruft nur Directory.Delete(string, bool) auf). Ein Treffer
// auf einen dieser zwei Calls ist ein zuverlässiger Patch-4-Marker.
static bool HasIterAndDeleteFingerprint(MethodDefinition dd)
{
    foreach (var insn in dd.Body.Instructions)
    {
        if (insn.OpCode != OpCodes.Call && insn.OpCode != OpCodes.Callvirt)
            continue;
        if (insn.Operand is MethodReference mr)
        {
            if (mr.Name == "GetFiles" && mr.DeclaringType.FullName == "System.IO.Directory")
                return true;
            if (mr.Name == "Delete" && mr.DeclaringType.FullName == "System.IO.File")
                return true;
        }
    }
    return false;
}

// IL-Generation für Patch 4: Body von StandaloneFilesystem.DeleteDirectory(string)
// komplett ersetzen durch Iter-and-Delete. Stock ist nur 6 Instructions
// (ldarg.0, ldarg.1, call Rel2Abs, ldc.i4.1, call Directory.Delete, ret).
// Neuer Body siehe Doku-Block in ProcessOtherDll.
static void ApplyDeleteDirectoryRewrite(MethodDefinition dd, ModuleDefinition module)
{
    var corlib = module.TypeSystem.CoreLibrary;
    var stringT  = module.TypeSystem.String;
    var intT     = module.TypeSystem.Int32;
    var boolT    = module.TypeSystem.Boolean;
    var voidT    = module.TypeSystem.Void;
    var stringArr = new ArrayType(stringT);

    // Type-Refs gegen die game-eigene mscorlib bauen (nicht aus .NET 10
    // typeof importieren — Mono-Runtime hätte einen TypeLoadException).
    var dirType   = new TypeReference("System.IO", "Directory", module, corlib);
    var fileType  = new TypeReference("System.IO", "File",      module, corlib);
    var soType    = new TypeReference("System.IO", "SearchOption", module, corlib) { IsValueType = true };
    var excType   = new TypeReference("System",    "Exception", module, corlib);

    MethodReference Mref(TypeReference owner, string name, TypeReference ret, bool hasThis, params TypeReference[] ps)
    {
        var mr = new MethodReference(name, ret, owner) { HasThis = hasThis };
        foreach (var p in ps) mr.Parameters.Add(new ParameterDefinition(p));
        return mr;
    }

    var getFiles      = Mref(dirType,  "GetFiles",       stringArr, false, stringT, stringT, soType);
    var getDirs       = Mref(dirType,  "GetDirectories", stringArr, false, stringT, stringT, soType);
    var dirDelete     = Mref(dirType,  "Delete",         voidT,     false, stringT, boolT);
    var fileDelete    = Mref(fileType, "Delete",         voidT,     false, stringT);
    var stringLength  = Mref(stringT,  "get_Length",     intT,      true);

    // Rel2Abs sitzt im selben Type — direct member-lookup.
    var rel2Abs = dd.DeclaringType.Methods.Single(m =>
        m.Name == "Rel2Abs" && m.Parameters.Count == 1
        && m.Parameters[0].ParameterType.FullName == "System.String");

    // Body neu aufbauen
    dd.Body.Instructions.Clear();
    dd.Body.ExceptionHandlers.Clear();
    dd.Body.Variables.Clear();
    dd.Body.InitLocals = true;

    var locAbs   = new VariableDefinition(stringT);    dd.Body.Variables.Add(locAbs);
    var locFiles = new VariableDefinition(stringArr);  dd.Body.Variables.Add(locFiles);
    var locDirs  = new VariableDefinition(stringArr);  dd.Body.Variables.Add(locDirs);
    var locI     = new VariableDefinition(intT);       dd.Body.Variables.Add(locI);
    var locJ     = new VariableDefinition(intT);       dd.Body.Variables.Add(locJ);
    var locTmp   = new VariableDefinition(stringT);    dd.Body.Variables.Add(locTmp);

    var il = dd.Body.GetILProcessor();

    // Hilfsmethode zum stable-emit (gibt die Instruction zurück, falls als Label gebraucht)
    Instruction Emit(OpCode op) { var i = Instruction.Create(op); il.Append(i); return i; }
    Instruction EmitOp(OpCode op, object operand)
    {
        Instruction i = operand switch
        {
            VariableDefinition v => Instruction.Create(op, v),
            MethodReference m    => Instruction.Create(op, m),
            string s             => Instruction.Create(op, s),
            Instruction t        => Instruction.Create(op, t),
            int n                => Instruction.Create(op, n),
            _ => throw new InvalidOperationException("operand type unsupported: " + operand.GetType())
        };
        il.Append(i);
        return i;
    }

    // === abs = this.Rel2Abs(path); === (markiert tryStart)
    var tryStart = Emit(OpCodes.Ldarg_0);
    Emit(OpCodes.Ldarg_1);
    EmitOp(OpCodes.Call, rel2Abs);
    EmitOp(OpCodes.Stloc, locAbs);

    // === files = Directory.GetFiles(abs, "*", SearchOption.AllDirectories); ===
    EmitOp(OpCodes.Ldloc, locAbs);
    EmitOp(OpCodes.Ldstr, "*");
    Emit(OpCodes.Ldc_I4_1);
    EmitOp(OpCodes.Call, getFiles);
    EmitOp(OpCodes.Stloc, locFiles);

    // === for (i = 0; i < files.Length; i++) File.Delete(files[i]); ===
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Stloc, locI);
    var loop1Test = Instruction.Create(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Br, loop1Test);
    var loop1Body = Instruction.Create(OpCodes.Ldloc, locFiles);
    il.Append(loop1Body);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Call, fileDelete);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locI);
    il.Append(loop1Test);
    EmitOp(OpCodes.Ldloc, locFiles);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, loop1Body);

    // === dirs = Directory.GetDirectories(abs, "*", AllDirectories); ===
    EmitOp(OpCodes.Ldloc, locAbs);
    EmitOp(OpCodes.Ldstr, "*");
    Emit(OpCodes.Ldc_I4_1);
    EmitOp(OpCodes.Call, getDirs);
    EmitOp(OpCodes.Stloc, locDirs);

    // === Bubble-sort dirs descending by string-length =====================
    // for (i = 0; i < dirs.Length; i++)
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Stloc, locI);
    var sortOTest = Instruction.Create(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Br, sortOTest);
    var sortOBody = Instruction.Create(OpCodes.Ldloc, locI);
    il.Append(sortOBody);
    //   for (j = i + 1; j < dirs.Length; j++)
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locJ);
    var sortITest = Instruction.Create(OpCodes.Ldloc, locJ);
    EmitOp(OpCodes.Br, sortITest);
    var sortIBody = Instruction.Create(OpCodes.Ldloc, locDirs);
    il.Append(sortIBody);
    //     if (dirs[j].Length > dirs[i].Length) { swap }
    EmitOp(OpCodes.Ldloc, locJ);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Callvirt, stringLength);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Callvirt, stringLength);
    var sortINext = Instruction.Create(OpCodes.Ldloc, locJ);
    EmitOp(OpCodes.Ble, sortINext);
    //     tmp = dirs[i]
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Stloc, locTmp);
    //     dirs[i] = dirs[j]
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locJ);
    Emit(OpCodes.Ldelem_Ref);
    Emit(OpCodes.Stelem_Ref);
    //     dirs[j] = tmp
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locJ);
    EmitOp(OpCodes.Ldloc, locTmp);
    Emit(OpCodes.Stelem_Ref);
    //   j++; goto sortITest
    il.Append(sortINext);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locJ);
    il.Append(sortITest);
    EmitOp(OpCodes.Ldloc, locDirs);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, sortIBody);
    // i++; goto sortOTest
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locI);
    il.Append(sortOTest);
    EmitOp(OpCodes.Ldloc, locDirs);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, sortOBody);

    // === for (i = 0; i < dirs.Length; i++) Directory.Delete(dirs[i], false); ===
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Stloc, locI);
    var loop2Test = Instruction.Create(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Br, loop2Test);
    var loop2Body = Instruction.Create(OpCodes.Ldloc, locDirs);
    il.Append(loop2Body);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Call, dirDelete);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locI);
    il.Append(loop2Test);
    EmitOp(OpCodes.Ldloc, locDirs);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, loop2Body);

    // === Directory.Delete(abs, false); ===
    EmitOp(OpCodes.Ldloc, locAbs);
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Call, dirDelete);

    // === leave END (try-Block-Exit) ===
    var endRet = Instruction.Create(OpCodes.Ret);
    EmitOp(OpCodes.Leave, endRet);

    // === catch (Exception) { pop; leave END } ===
    var catchStart = Instruction.Create(OpCodes.Pop);
    il.Append(catchStart);
    EmitOp(OpCodes.Leave, endRet);

    // === ret ===
    il.Append(endRet);

    // ExceptionHandler: try [tryStart..catchStart) catch [catchStart..endRet)
    dd.Body.ExceptionHandlers.Add(new ExceptionHandler(ExceptionHandlerType.Catch)
    {
        TryStart     = tryStart,
        TryEnd       = catchStart,
        HandlerStart = catchStart,
        HandlerEnd   = endRet,
        CatchType    = excType,
    });
}

static bool HasPopPopFingerprint(TypeDefinition t)
{
    foreach (var m in t.Methods)
    {
        if (!m.HasBody) continue;
        foreach (var insn in m.Body.Instructions)
        {
            if (insn.OpCode == OpCodes.Ldc_I4_1
                && insn.Next?.OpCode == OpCodes.Pop
                && insn.Next.Next?.OpCode == OpCodes.Pop)
                return true;
        }
    }
    return false;
}

