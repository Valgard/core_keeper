}

// IL-Generation für Patch 5: Body von StandaloneFilesystem.Delete(string)
// komplett ersetzen durch Wine-safes Hard-Delete:
//     try {
//         string abs = Rel2Abs(path);
//         if (File.Exists(abs)) File.Delete(abs);
//         string bak = Rel2Abs(path + ".pugbackup");
//         if (File.Exists(bak)) File.Delete(bak);
//     } catch (Exception) { }
static void ApplyDeleteRewrite(MethodDefinition del, ModuleDefinition module)
{
    var corlib  = module.TypeSystem.CoreLibrary;
    var stringT = module.TypeSystem.String;
    var boolT   = module.TypeSystem.Boolean;
    var voidT   = module.TypeSystem.Void;

    var fileType = new TypeReference("System.IO", "File",      module, corlib);
    var excType  = new TypeReference("System",    "Exception", module, corlib);

    MethodReference Mref(TypeReference owner, string name, TypeReference ret, bool hasThis, params TypeReference[] ps)
    {
        var mr = new MethodReference(name, ret, owner) { HasThis = hasThis };
        foreach (var p in ps) mr.Parameters.Add(new ParameterDefinition(p));
        return mr;
    }

    var fileExists = Mref(fileType, "Exists", boolT,    false, stringT);
    var fileDelete = Mref(fileType, "Delete", voidT,    false, stringT);
    var strConcat  = Mref(stringT,  "Concat", stringT,  false, stringT, stringT);

    // Rel2Abs sitzt im selben Type — direct member-lookup (instance method).
    var rel2Abs = del.DeclaringType.Methods.Single(m =>
        m.Name == "Rel2Abs" && m.Parameters.Count == 1
        && m.Parameters[0].ParameterType.FullName == "System.String");

    del.Body.Instructions.Clear();
    del.Body.ExceptionHandlers.Clear();
    del.Body.Variables.Clear();
    del.Body.InitLocals = true;

    var locAbs = new VariableDefinition(stringT); del.Body.Variables.Add(locAbs);
    var locBak = new VariableDefinition(stringT); del.Body.Variables.Add(locBak);

    var il = del.Body.GetILProcessor();
    Instruction Emit(OpCode op) { var i = Instruction.Create(op); il.Append(i); return i; }
    Instruction EmitOp(OpCode op, object operand)
    {
        Instruction i = operand switch
        {
            VariableDefinition v => Instruction.Create(op, v),
            MethodReference m    => Instruction.Create(op, m),
            string s             => Instruction.Create(op, s),
            Instruction t        => Instruction.Create(op, t),
            int n                => Instruction.Create(op, n),
            _ => throw new InvalidOperationException("operand type unsupported: " + operand.GetType())
        };
        il.Append(i);
        return i;
    }

    var endRet = Instruction.Create(OpCodes.Ret);

    // === abs = this.Rel2Abs(path); === (markiert tryStart)
    var tryStart = Emit(OpCodes.Ldarg_0);
    Emit(OpCodes.Ldarg_1);
    EmitOp(OpCodes.Call, rel2Abs);
    EmitOp(OpCodes.Stloc, locAbs);

    // === if (File.Exists(abs)) File.Delete(abs); ===
    EmitOp(OpCodes.Ldloc, locAbs);
    EmitOp(OpCodes.Call, fileExists);
    var bakStart = Instruction.Create(OpCodes.Ldarg_0);  // erste Insn der bak-Berechnung
    EmitOp(OpCodes.Brfalse, bakStart);
    EmitOp(OpCodes.Ldloc, locAbs);
    EmitOp(OpCodes.Call, fileDelete);

    // === bak = this.Rel2Abs(path + ".pugbackup"); ===
    il.Append(bakStart);             // ldarg.0 (this für Rel2Abs)
    Emit(OpCodes.Ldarg_1);           // path
    EmitOp(OpCodes.Ldstr, ".pugbackup");
    EmitOp(OpCodes.Call, strConcat);
    EmitOp(OpCodes.Call, rel2Abs);
    EmitOp(OpCodes.Stloc, locBak);

    // === if (File.Exists(bak)) File.Delete(bak); ===
    EmitOp(OpCodes.Ldloc, locBak);
    EmitOp(OpCodes.Call, fileExists);
    var afterBakDelete = Instruction.Create(OpCodes.Leave, endRet);
    EmitOp(OpCodes.Brfalse, afterBakDelete);
    EmitOp(OpCodes.Ldloc, locBak);
    EmitOp(OpCodes.Call, fileDelete);
    il.Append(afterBakDelete);       // leave END (try-Block-Exit)

    // === catch (Exception) { pop; leave END } ===
    var catchStart = Instruction.Create(OpCodes.Pop);
    il.Append(catchStart);
    EmitOp(OpCodes.Leave, endRet);

    // === ret ===
    il.Append(endRet);

    del.Body.ExceptionHandlers.Add(new ExceptionHandler(ExceptionHandlerType.Catch)
    {
        TryStart     = tryStart,
        TryEnd       = catchStart,
        HandlerStart = catchStart,
        HandlerEnd   = endRet,
        CatchType    = excType,
    });
}

// ============================================================================
// modio.UnityPlugin.dll — Patch 6 (SystemIOWrapper.DeleteDirectory rewrite)
// ============================================================================
// Mod-Löschen im In-Game-Mod-Menü läuft NICHT über Pug, sondern komplett in der
// separaten modio.UnityPlugin.dll:
//   ModManagement.TryUninstall -> DataStorage.TryDeleteInstalledMod
//     -> SystemIOWrapper.DeleteDirectory(string) (static)
//       -> Directory.Delete(path, recursive: true)   // <-- Wine-broken
//
// Das ist exakt derselbe rekursive-Delete-Bug, den Patch 4 in Pug.Other behebt —
// nur in einer anderen Assembly, die Patch 4 nie berührt. Patch 6 injiziert eine
// Wine-safe Iter-and-Delete Helper-Methode (CorekeeperWineSafeDeleteDir) in
// SystemIOWrapper und biegt den einen Directory.Delete(string,bool)-Call in der
// static DeleteDirectory auf diesen Helper um (bool-Argument wird entfernt).
// modio's bestehender try/catch (IOException/UnauthorizedAccess/Exception) um den
// Call herum bleibt erhalten — der Helper braucht daher kein eigenes Swallow und
// echte Fehler werden weiterhin als modio-Result-Code gemeldet.
static int ProcessModioDll(string dllPath, bool apply)
{
    Console.WriteLine();
    Console.WriteLine("DLL: " + dllPath);
    Console.WriteLine();

    if (!File.Exists(dllPath))
    {
        Console.Error.WriteLine("FEHLER: DLL nicht gefunden.");
        return 1;
    }

    var resolver = new DefaultAssemblyResolver();
    resolver.AddSearchDirectory(Path.GetDirectoryName(dllPath));

    using var module = ModuleDefinition.ReadModule(
        dllPath, new ReaderParameters
        {
            ReadWrite = apply,
            AssemblyResolver = resolver,
        });

    var wrapperType = module.GetType(ModioWrapperType);
    if (wrapperType == null)
    {
        Console.Error.WriteLine("FEHLER: Typ " + ModioWrapperType
            + " nicht gefunden — modio verändert? Kein Patch angewendet.");
        return 1;
    }

    bool anyChange = false;
    bool anyGameChanged = false;
    bool allWereUnpatched = true;

    {
        bool helperPresent = wrapperType.Methods.Any(m => m.Name == ModioHelperName);

        var ddMethods = wrapperType.Methods.Where(m =>
            m.Name == "DeleteDirectory" && m.IsStatic && m.HasBody
            && m.Parameters.Count == 1
            && m.Parameters[0].ParameterType.FullName == "System.String"
        ).ToList();

        if (helperPresent)
        {
            allWereUnpatched = false;
            Report(6, "modio DeleteDirectory rewrite", "BEREITS GEPATCHT");
        }
        else if (ddMethods.Count != 1)
        {
            anyGameChanged = true;
            allWereUnpatched = false;
            Report(6, "modio DeleteDirectory rewrite",
                "SPIEL VERÄNDERT — übersprungen (" + ddMethods.Count
                + " static DeleteDirectory(string) gefunden, erwartet 1)");
        }
        else
        {
            var dd = ddMethods[0];
            var hits = dd.Body.Instructions.Where(insn =>
                (insn.OpCode == OpCodes.Call || insn.OpCode == OpCodes.Callvirt)
                && insn.Operand is MethodReference mr
                && IsDirectoryDeleteStringBool(mr)).ToList();

            if (hits.Count != 1 || hits[0].Previous?.OpCode != OpCodes.Ldc_I4_1)
            {
                anyGameChanged = true;
                allWereUnpatched = false;
                Report(6, "modio DeleteDirectory rewrite",
                    "SPIEL VERÄNDERT — übersprungen (" + hits.Count
                    + " Directory.Delete(string,bool) mit ldc.i4.1-Prefix, erwartet 1)");
            }
            else if (apply)
            {
                ApplyModioDeleteDirectoryRewrite(dd, wrapperType, hits[0], module);
                anyChange = true;
                Report(6, "modio DeleteDirectory rewrite",
                    "NICHT GEPATCHT -> GEPATCHT [OK]  (Directory.Delete -> "
                    + ModioHelperName + ")");
            }
            else
            {
                Report(6, "modio DeleteDirectory rewrite",
                    "NICHT GEPATCHT  (DeleteDirectory, Directory.Delete @ IL 0x"
                    + hits[0].Offset.ToString("X4") + ")");
            }
        }
    }

    if (apply && anyChange)
    {
        WriteDll(dllPath, module, allWereUnpatched);
    }

    return anyGameChanged ? 1 : 0;
}

// Biegt den Directory.Delete(string,bool)-Call der static DeleteDirectory auf
// den injizierten Wine-safe Helper um. Stack vor dem Call: [path, true]. Der
// Helper braucht nur [path], also wird der bool-Push (ldc.i4.1, vorab validiert)
// entfernt und der Call-Operand ausgetauscht.
static void ApplyModioDeleteDirectoryRewrite(
    MethodDefinition dd, TypeDefinition wrapperType,
    Instruction dirDeleteCall, ModuleDefinition module)
{
    var helper = BuildWineSafeDeleteHelper(module);
    wrapperType.Methods.Add(helper);

    var il = dd.Body.GetILProcessor();
    var boolPush = dirDeleteCall.Previous;   // ldc.i4.1 (recursive: true)
    il.Remove(boolPush);
    dirDeleteCall.OpCode = OpCodes.Call;
    dirDeleteCall.Operand = helper;
}

// Baut die static void CorekeeperWineSafeDeleteDir(string path)-Helper-Methode.
// path ist hier bereits absolut (modio reicht absolute Pfade) — daher kein
// Rel2Abs. Identischer Iter-and-Delete-Algorithmus wie Patch 4, ohne try/catch
// (modio's umgebender Handler fängt), terminiert mit ret.
static MethodDefinition BuildWineSafeDeleteHelper(ModuleDefinition module)
{
    var corlib    = module.TypeSystem.CoreLibrary;
    var stringT   = module.TypeSystem.String;
    var intT      = module.TypeSystem.Int32;
    var boolT     = module.TypeSystem.Boolean;
    var voidT     = module.TypeSystem.Void;
    var stringArr = new ArrayType(stringT);

    var dirType  = new TypeReference("System.IO", "Directory",    module, corlib);
    var fileType = new TypeReference("System.IO", "File",         module, corlib);
    var soType   = new TypeReference("System.IO", "SearchOption", module, corlib) { IsValueType = true };

    MethodReference Mref(TypeReference owner, string name, TypeReference ret, bool hasThis, params TypeReference[] ps)
    {
        var mr = new MethodReference(name, ret, owner) { HasThis = hasThis };
        foreach (var p in ps) mr.Parameters.Add(new ParameterDefinition(p));
        return mr;
    }

    var getFiles     = Mref(dirType,  "GetFiles",       stringArr, false, stringT, stringT, soType);
    var getDirs      = Mref(dirType,  "GetDirectories", stringArr, false, stringT, stringT, soType);
    var dirDelete    = Mref(dirType,  "Delete",         voidT,     false, stringT, boolT);
    var fileDelete   = Mref(fileType, "Delete",         voidT,     false, stringT);
    var stringLength = Mref(stringT,  "get_Length",     intT,      true);

    var helper = new MethodDefinition(ModioHelperName,
        MethodAttributes.Private | MethodAttributes.Static | MethodAttributes.HideBySig,
        voidT);
    helper.Parameters.Add(new ParameterDefinition("path", ParameterAttributes.None, stringT));

    var body = helper.Body;
    body.InitLocals = true;
    var locFiles = new VariableDefinition(stringArr); body.Variables.Add(locFiles);
    var locDirs  = new VariableDefinition(stringArr); body.Variables.Add(locDirs);
    var locI     = new VariableDefinition(intT);      body.Variables.Add(locI);
    var locJ     = new VariableDefinition(intT);      body.Variables.Add(locJ);
    var locTmp   = new VariableDefinition(stringT);   body.Variables.Add(locTmp);

    var il = body.GetILProcessor();
    Instruction Emit(OpCode op) { var i = Instruction.Create(op); il.Append(i); return i; }
    Instruction EmitOp(OpCode op, object operand)
    {
        Instruction i = operand switch
        {
            VariableDefinition v => Instruction.Create(op, v),
            MethodReference m    => Instruction.Create(op, m),
            string s             => Instruction.Create(op, s),
            Instruction t        => Instruction.Create(op, t),
            int n                => Instruction.Create(op, n),
            _ => throw new InvalidOperationException("operand type unsupported: " + operand.GetType())
        };
        il.Append(i);
        return i;
    }

    // files = Directory.GetFiles(path, "*", AllDirectories);
    Emit(OpCodes.Ldarg_0);
    EmitOp(OpCodes.Ldstr, "*");
    Emit(OpCodes.Ldc_I4_1);
    EmitOp(OpCodes.Call, getFiles);
    EmitOp(OpCodes.Stloc, locFiles);

    // for (i=0; i<files.Length; i++) File.Delete(files[i]);
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Stloc, locI);
    var loop1Test = Instruction.Create(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Br, loop1Test);
    var loop1Body = Instruction.Create(OpCodes.Ldloc, locFiles);
    il.Append(loop1Body);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Call, fileDelete);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locI);
    il.Append(loop1Test);
    EmitOp(OpCodes.Ldloc, locFiles);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, loop1Body);

    // dirs = Directory.GetDirectories(path, "*", AllDirectories);
    Emit(OpCodes.Ldarg_0);
    EmitOp(OpCodes.Ldstr, "*");
    Emit(OpCodes.Ldc_I4_1);
    EmitOp(OpCodes.Call, getDirs);
    EmitOp(OpCodes.Stloc, locDirs);

    // Bubble-sort dirs descending by string-length (deepest first)
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Stloc, locI);
    var sortOTest = Instruction.Create(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Br, sortOTest);
    var sortOBody = Instruction.Create(OpCodes.Ldloc, locI);
    il.Append(sortOBody);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locJ);
    var sortITest = Instruction.Create(OpCodes.Ldloc, locJ);
    EmitOp(OpCodes.Br, sortITest);
    var sortIBody = Instruction.Create(OpCodes.Ldloc, locDirs);
    il.Append(sortIBody);
    EmitOp(OpCodes.Ldloc, locJ);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Callvirt, stringLength);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Callvirt, stringLength);
    var sortINext = Instruction.Create(OpCodes.Ldloc, locJ);
    EmitOp(OpCodes.Ble, sortINext);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    EmitOp(OpCodes.Stloc, locTmp);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locJ);
    Emit(OpCodes.Ldelem_Ref);
    Emit(OpCodes.Stelem_Ref);
    EmitOp(OpCodes.Ldloc, locDirs);
    EmitOp(OpCodes.Ldloc, locJ);
    EmitOp(OpCodes.Ldloc, locTmp);
    Emit(OpCodes.Stelem_Ref);
    il.Append(sortINext);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locJ);
    il.Append(sortITest);
    EmitOp(OpCodes.Ldloc, locDirs);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, sortIBody);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locI);
    il.Append(sortOTest);
    EmitOp(OpCodes.Ldloc, locDirs);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, sortOBody);

    // for (i=0; i<dirs.Length; i++) Directory.Delete(dirs[i], false);
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Stloc, locI);
    var loop2Test = Instruction.Create(OpCodes.Ldloc, locI);
    EmitOp(OpCodes.Br, loop2Test);
    var loop2Body = Instruction.Create(OpCodes.Ldloc, locDirs);
    il.Append(loop2Body);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldelem_Ref);
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Call, dirDelete);
    EmitOp(OpCodes.Ldloc, locI);
    Emit(OpCodes.Ldc_I4_1);
    Emit(OpCodes.Add);
    EmitOp(OpCodes.Stloc, locI);
    il.Append(loop2Test);
    EmitOp(OpCodes.Ldloc, locDirs);
    Emit(OpCodes.Ldlen);
    Emit(OpCodes.Conv_I4);
    EmitOp(OpCodes.Blt, loop2Body);

    // Directory.Delete(path, false);
    Emit(OpCodes.Ldarg_0);
    Emit(OpCodes.Ldc_I4_0);
    EmitOp(OpCodes.Call, dirDelete);

    Emit(OpCodes.Ret);

    return helper;
}
