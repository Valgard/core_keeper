static void WriteDll(string dllPath, ModuleDefinition module, bool allWereUnpatched)
{
    // Backup-Logik:
    // - allWereUnpatched=true heißt: die Live-DLL war vor diesem apply VOLL stock
    //   (alle Patches dieser DLL waren NICHT GEPATCHT). Damit ist die aktuelle
    //   Live-DLL eine gültige Stock-Referenz und der Backup darf aktualisiert
    //   werden — insbesondere wichtig nach einem CK-Update, das die Live-DLL
    //   ersetzt, während der alte Backup im Filesystem stehen bleibt.
    // - allWereUnpatched=false heißt: mindestens ein Patch war bereits drin
    //   (teil-gepatchte Live-DLL). Aus dieser DLL können wir nicht zuverlässig
    //   Stock rekonstruieren, also Backup unangetastet lassen.
    string backup = dllPath + ".prepatch-backup";
    Console.WriteLine();

    bool backupExists = File.Exists(backup);

    if (!backupExists)
    {
        if (allWereUnpatched)
        {
            File.Copy(dllPath, backup);
            Console.WriteLine("Backup angelegt: " + Path.GetFileName(backup));
        }
        else
        {
            Console.WriteLine("WARNUNG: kein Backup vorhanden + Live-DLL bereits "
                + "teil-gepatcht → kein zuverlässiger Backup erstellbar. "
                + "Empfehlung: Steam-Verify und apply erneut laufen lassen, "
                + "damit ein Stock-Backup angelegt werden kann.");
        }
    }
    else if (allWereUnpatched)
    {
        // Backup vorhanden UND Live-DLL ist stock — perfekter Moment, den
        // Backup zu refreshen, falls er von einer früheren CK-Version stammt.
        long oldSize = new FileInfo(backup).Length;
        long newSize = new FileInfo(dllPath).Length;
        DateTime oldMtime = File.GetLastWriteTime(backup);
        DateTime newMtime = File.GetLastWriteTime(dllPath);

        File.Copy(dllPath, backup, overwrite: true);

        string sizeDelta = oldSize == newSize
            ? "Größe identisch"
            : oldSize + " -> " + newSize + " bytes";
        string mtimeNote = oldMtime.Date == newMtime.Date
            ? "selbes Datum"
            : oldMtime.ToString("yyyy-MM-dd") + " -> " + newMtime.ToString("yyyy-MM-dd");
        Console.WriteLine("Backup aktualisiert (" + sizeDelta + ", " + mtimeNote
            + "): " + Path.GetFileName(backup));
    }
    else
    {
        Console.WriteLine("Backup existiert, Live-DLL teil-gepatcht — Backup "
            + "nicht refreshable aus Live-Stand. Falls als veraltet bekannt: "
            + "manuell löschen, Steam-Verify, apply erneut.");
    }

    module.Write();
}

