#!/usr/bin/env bash
# core_keeper/.envrc.example — tracked template for the shared, machine-level
# environment inherited by EVERY Core Keeper mod. Copy it to .envrc and replace
# every "/path/to/…" placeholder with the real absolute path:
#
#   cp .envrc.example .envrc   # then edit the placeholder paths
#   direnv allow               # here, and once in each mod dir
#
# The real .envrc is gitignored; this template is committed via the
# `!/.envrc.example` allowlist line in .gitignore. Keep the two in sync — both
# the variables and their comments.
#
# Each mod's .envrc inherits these values via direnv's `source_up_if_exists`
# (with a manual `source ../.envrc` fallback for the documented
# `source .envrc && ../utils/build.sh` workflow), so the shared machine paths
# below are defined ONCE here instead of duplicated per mod.
#
# Paths are ABSOLUTE on purpose: direnv's source_up sources this file without
# changing $PWD (it stays the mod dir), so a $PWD-relative path here would not
# resolve to core_keeper/.

# --- Machine paths (shared by all mods) -------------------------------------

# Unity Editor binary — MUST be Unity 6000.0.59f2, the version pinned in the
# SDK's ProjectVersion.txt (its README is one patch behind — do not trust it).
# The path below is the canonical macOS Unity Hub location.
export UNITY_BIN="/Applications/Unity/Hub/Editor/6000.0.59f2/Unity.app/Contents/MacOS/Unity"

# Cloned Pugstorm CoreKeeperModSDK — the one shared clone, never vendored per
# mod. Absolute, because the SDK symlinks (utils/link.sh) encode absolute paths.
export SDK_PATH="/path/to/core_keeper/CoreKeeperModSDK"

# macOS only — CrossOver bottle that holds Core Keeper. The install/uninstall
# scripts use these defaults if unset. Set CK_BOTTLE_NAME for a differently
# named bottle in the standard location, CK_BOTTLE_PATH for a non-standard
# location (overrides CK_BOTTLE_NAME), or CK_WINE_USER for a non-default user.
# export CK_BOTTLE_NAME="Core Keeper"
# export CK_BOTTLE_PATH="$HOME/Library/Application Support/CrossOver/Bottles/Core Keeper"
# export CK_WINE_USER="crossover"

# macOS only — dedicated server (utils/server.sh). All optional; the defaults
# shown are what the script uses when unset. CK_SERVER_DIR defaults to the
# server install inside CK_BOTTLE_PATH. See docs/dedicated-server.md.
# export CK_SERVER_WORLD="0"           # world index 0-29
# export CK_SERVER_PORT="27015"        # empty = Steam relay only, no direct connect
# export CK_SERVER_PASSWORD=""         # empty = server generates one into GameInfo.txt
# export CK_SERVER_MAXPLAYERS="8"
# export CK_SERVER_PLATFORM="Steam"    # empty = allow all platforms (needs the crossplay privilege)
# export CK_SERVER_DIR="$CK_BOTTLE_PATH/drive_c/Program Files (x86)/Steam/steamapps/common/Core Keeper Dedicated Server"

# Where ModBuilder stages its output — one directory shared by every mod, so a
# mod's .envrc no longer sets MOD_INSTALL_PATH. ModBuilder creates a <ModName>/
# subdirectory itself, which is why no per-mod component is needed here, and why
# the old "<mod-id>-build/<ModName>/" named the same mod twice. That <ModName>
# subdirectory is also what the SDK's Steam Workshop tab matches on — it picks
# its content folder by EndsWith() on the PascalCase mod name.
export MOD_INSTALL_BASE_PATH="$HOME/Library/Caches"
export MOD_INSTALL_PATH="$MOD_INSTALL_BASE_PATH/CoreKeeperMods"

# --- Shared defaults (a mod's own .envrc may override) ----------------------

# Core Keeper game versions → mod.io compatibility tags for ALL mods. This is
# the single canonical list — mods do NOT override CK_GAME_VERSION; keep it in
# sync here as new game builds ship. Space-separated; each value becomes its own
# mod.io compatibility tag.
export CK_GAME_VERSION="1.2.1.5 1.2.1.4 1.2.1.3 1.2.1.2 1.2.1.0 1.2.0.7 1.2.0.6 1.2.0.5 1.2.0.4 1.2.0.3"

# Builds that shipped but have no mod.io "Game Version" tag, space-separated.
# CLIPublishHelper drops these from CK_GAME_VERSION before publishing, so the
# list above can stay truthful for everything else that reads it (the Discord
# post does) while the publish guard keeps refusing values mod.io does not know
# — that guard exists to catch typos, and softening it for these would blunt it.
# 1.2.1.2 shipped 2026-05-07 (Steam patch notes) and mod.io has no tag for it;
# 1.0.0.7 and 1.0.0.12 are the same case, older. Delete an entry as soon as
# mod.io offers the tag — the publish fails until you do, by design.
export CK_MODIO_VERSION_UNLISTED="1.2.1.2"

# --- Shared utils/ data files (absolute — source_up keeps $PWD = mod dir) ---

# Self-populating modName → mod.io ModId cache, read/written by the shared
# CLIPublishHelper when syncing platform dependencies.
export MODIO_DEPS_MAP="/path/to/core_keeper/utils/modio-dependencies.json"

# CK language address → ISO table used by the shared LocalizationGenerator.
# Harmless for non-localised mods (their generator run is a no-op).
export LOC_TABLE="/path/to/core_keeper/utils/ck-language-addresses.json"

# --- Project-local PATH additions -------------------------------------------

# ilspycmd is a .NET global tool under ~/.dotnet/tools, not on macOS PATH by
# default. Sourced project-locally; harmless when unused, needed for
# decompiling game DLLs.
export PATH="$HOME/.dotnet/tools:$PATH"
